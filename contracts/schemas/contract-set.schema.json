{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maestro.contract-set/1",
  "title": "MaestroRecord",
  "oneOf": [
    {
      "$ref": "#/$defs/ReleaseManifest"
    },
    {
      "$ref": "#/$defs/ReleaseSignature"
    },
    {
      "$ref": "#/$defs/AcceptanceSignature"
    },
    {
      "$ref": "#/$defs/TransitionSignature"
    },
    {
      "$ref": "#/$defs/TrustRoot"
    },
    {
      "$ref": "#/$defs/TrustTransition"
    },
    {
      "$ref": "#/$defs/ValidatorRegistry"
    },
    {
      "$ref": "#/$defs/RuntimeBootstrap"
    },
    {
      "$ref": "#/$defs/CompatibilityCatalog"
    },
    {
      "$ref": "#/$defs/AcceptancePolicy"
    },
    {
      "$ref": "#/$defs/ReleaseAcceptance"
    },
    {
      "$ref": "#/$defs/ArtifactProfile"
    },
    {
      "$ref": "#/$defs/JsonFixture"
    },
    {
      "$ref": "#/$defs/ValidationReport"
    },
    {
      "$ref": "#/$defs/ResourceProfile"
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "role": {
          "type": "string",
          "maxLength": 128,
          "enum": [
            "launcher",
            "controller",
            "gateway",
            "plugin",
            "dsh",
            "node",
            "schema",
            "binding",
            "validator",
            "profile",
            "bootstrap",
            "catalog",
            "lock",
            "provenance",
            "notice"
          ]
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "classification": {
          "type": "string",
          "maxLength": 128,
          "enum": [
            "executable",
            "data"
          ]
        }
      },
      "required": [
        "path",
        "role",
        "sha256",
        "size",
        "classification"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "files": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          }
        },
        "notices": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          }
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "name",
        "version",
        "rationale",
        "files",
        "notices",
        "source"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "outcome": {
          "type": "string",
          "maxLength": 128,
          "enum": [
            "pass",
            "fail",
            "error"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "id",
        "outcome",
        "evidence"
      ]
    },
    "reader": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "maxLength": 128,
              "const": "self"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "maxLength": 128,
              "const": "release"
            },
            "manifest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "manifest"
          ]
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencies": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "stage": {
          "type": "string",
          "maxLength": 128,
          "enum": [
            "draft",
            "accepted"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "validator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "configuration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "executor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "project",
        "scope",
        "subject",
        "revision",
        "input",
        "dependencies",
        "family",
        "stage",
        "profile",
        "schema",
        "validator",
        "configuration",
        "executor",
        "environment"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "string",
          "maxLength": 128,
          "enum": [
            "PARSE",
            "STRUCTURE",
            "BINDING",
            "INTEGRITY",
            "COVERAGE",
            "CHECKER",
            "TIMEOUT"
          ]
        },
        "location": {
          "type": "string",
          "maxLength": 128,
          "enum": [
            "$",
            "$.schema",
            "$.value",
            "$.dependencies",
            "$.checks",
            "$.binding"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 128,
          "enum": [
            "Input rejected",
            "Required check failed",
            "Required check unavailable",
            "Snapshot changed",
            "Trusted bytes mismatch",
            "Required coverage incomplete"
          ]
        },
        "hint": {
          "type": "string",
          "maxLength": 128,
          "enum": [
            "Correct the editable draft and recheck",
            "Restore from independently trusted evidence",
            "Run the required checker again"
          ]
        }
      },
      "required": [
        "rule",
        "location",
        "message",
        "hint"
      ]
    },
    "ReleaseManifest": {
      "title": "ReleaseManifest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.release.manifest/1"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_tree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "signer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "trust_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "digest_profile": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.raw-sha256/1"
        },
        "signature_profile": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.ed25519-strict/1"
        },
        "files": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "components": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "registry": {
          "$ref": "#/$defs/reference"
        },
        "bootstrap": {
          "$ref": "#/$defs/reference"
        },
        "catalog": {
          "$ref": "#/$defs/reference"
        },
        "acceptance_policy": {
          "$ref": "#/$defs/reference"
        },
        "migrations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          }
        }
      },
      "required": [
        "schema",
        "version",
        "source_commit",
        "source_tree",
        "route",
        "signer",
        "trust_revision",
        "digest_profile",
        "signature_profile",
        "files",
        "components",
        "registry",
        "bootstrap",
        "catalog",
        "acceptance_policy",
        "migrations"
      ]
    },
    "ReleaseSignature": {
      "title": "ReleaseSignature",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.release.signature/1"
        },
        "public_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "required": [
        "schema",
        "public_key",
        "signature"
      ]
    },
    "AcceptanceSignature": {
      "title": "AcceptanceSignature",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.release.acceptance-signature/1"
        },
        "public_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "required": [
        "schema",
        "public_key",
        "signature"
      ]
    },
    "TransitionSignature": {
      "title": "TransitionSignature",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.trust.transition-signature/1"
        },
        "public_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "required": [
        "schema",
        "public_key",
        "signature"
      ]
    },
    "TrustRoot": {
      "title": "TrustRoot",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.trust.root/1"
        },
        "purpose": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.distribution"
        },
        "public_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "status": {
          "type": "string",
          "maxLength": 128,
          "enum": [
            "active",
            "revoked"
          ]
        }
      },
      "required": [
        "schema",
        "purpose",
        "public_key",
        "fingerprint",
        "revision",
        "status"
      ]
    },
    "TrustTransition": {
      "title": "TrustTransition",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.trust.transition/1"
        },
        "purpose": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.distribution"
        },
        "old_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43
        },
        "new_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      },
      "required": [
        "schema",
        "purpose",
        "old_key",
        "new_key",
        "revision"
      ]
    },
    "ValidatorRegistry": {
      "title": "ValidatorRegistry",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.validator.registry/1"
        },
        "validator": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.validators/1"
        },
        "schemas": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
              }
            },
            "required": [
              "id",
              "sha256",
              "path"
            ]
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "required": [
        "schema",
        "validator",
        "schemas",
        "profiles",
        "bindings"
      ]
    },
    "RuntimeBootstrap": {
      "title": "RuntimeBootstrap",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.runtime.bootstrap/1"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "database_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "catalog_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "minimum_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "migrations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          }
        }
      },
      "required": [
        "schema",
        "runtime",
        "database_schema",
        "catalog_schema",
        "minimum_policy",
        "migrations"
      ]
    },
    "CompatibilityCatalog": {
      "title": "CompatibilityCatalog",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 128,
          "const": "maestro.compatibility.catalog/1"
        },
        "entries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "domain": {
                "type": "string",
                "maxLength": 128,
                "enum": [
                  "installation",
                  "project"
                ]
              },
              "source_contract": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "source_schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "source_profile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "reader": {
                "$ref": "#/$defs/reader"
              },
              "route": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "minimum_policy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "capability": {
                "type": "string",
                "maxLength": 128,
                "enum": [
                  "historical_read",
                  "current_state_read",
                  "execute",
                  "full_migration",
                  "prospective_adoption"
                ]
              },
              "implementation": {
                "type": "array",
                "minItems": 0,
                "maxItems": 16,
                "items": {
                  "$ref": "#/$defs/reference"
                }
              },
              "preconditions": {
                "type": "array",
                "minItems": 0,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                }
              },
              "postconditions": {
                "type": "array",
                "minItems": 0,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                }
              },
              "recovery": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              }
            },
            "required": [
              "domain",
              "source_contract",
              "source_schema",
              "source_profile",
